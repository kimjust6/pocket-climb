<%
    const serializedClimbMediaMap = {};
    (climbs || []).forEach((cl) => {
        if (!cl || !cl.id) return;
        serializedClimbMediaMap[cl.id] = {
            name: cl.name || '',
            hasContributor: Boolean(cl.createdByUser),
            media: cl.media || []
        };
    });
    const safeClimbMediaJson = JSON.stringify(serializedClimbMediaMap).replace(/</g, '\\u003c');
    const safeImgurClientIdJson = JSON.stringify(imgurClientId || '').replace(/</g, '\\u003c');
    const safeLoginRedirectUrl = '/login?redirect=' + encodeURIComponent(canonicalPath || '/');
%>
<script id="climb-media-state" type="application/json"><%- safeClimbMediaJson %></script>

<!-- Lightbox Modal -->
<dialog id="climb-media-lightbox-modal" class="modal">
    <div class="modal-box max-w-4xl bg-base-100 border border-secondary/20 rounded-2xl p-4 sm:p-6 shadow-2xl">
        <div class="flex items-start justify-between gap-3 mb-3">
            <div>
                <h3 id="lightbox-climb-title" class="text-lg font-bold text-secondary"></h3>
                <p id="lightbox-meta" class="text-xs text-base-content/60 font-mono mt-0.5"></p>
            </div>
            <button type="button" id="lightbox-close-btn" class="btn btn-sm btn-ghost btn-circle" aria-label="Close photo viewer">✕</button>
        </div>

        <div class="relative flex items-center justify-center bg-base-200/70 rounded-xl overflow-hidden min-h-[220px] max-h-[70vh]">
            <img id="lightbox-img" src="" alt="" referrerpolicy="no-referrer" class="max-h-[70vh] w-auto max-w-full object-contain my-0" />
            <button type="button" id="lightbox-prev-btn" class="btn btn-circle btn-sm bg-base-100/80 border border-base-content/20 absolute left-2 top-1/2 -translate-y-1/2 hidden" aria-label="Previous photo">‹</button>
            <button type="button" id="lightbox-next-btn" class="btn btn-circle btn-sm bg-base-100/80 border border-base-content/20 absolute right-2 top-1/2 -translate-y-1/2 hidden" aria-label="Next photo">›</button>
        </div>

        <div class="mt-4 flex flex-wrap items-center justify-between gap-2">
            <span id="lightbox-counter" class="text-xs font-mono text-base-content/60"></span>
            <div class="flex items-center gap-2 ml-auto">
                <button type="button" id="lightbox-delete-btn" class="btn btn-xs btn-error btn-outline hidden">Delete Photo</button>
                <a id="lightbox-open-original" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-xs btn-ghost text-accent no-underline">
                    Open original ↗
                </a>
            </div>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop">
        <button aria-label="Close">close</button>
    </form>
</dialog>

<% if (isAuthenticated) { %>
<!-- Upload Photo Modal -->
<dialog id="climb-media-upload-modal" class="modal">
    <div class="modal-box max-w-lg bg-base-100 border border-secondary/20 rounded-2xl p-6 shadow-2xl">
        <div class="flex items-start justify-between gap-3 mb-4">
            <div>
                <h3 class="text-lg font-bold text-secondary">Add Climb Photo</h3>
                <p id="upload-modal-climb-name" class="text-sm text-base-content/70 mt-0.5"></p>
            </div>
            <button type="button" id="upload-modal-close-btn" class="btn btn-sm btn-ghost btn-circle" aria-label="Close upload dialog">✕</button>
        </div>

        <% if (!isImgurConfigured) { %>
            <div class="alert alert-warning text-xs mb-4">
                <span>Imgur uploads are not configured yet. Set <code>IMGUR_CLIENT_ID</code> in <code>.env</code> or PocketBase <code>admin_settings</code>.</span>
            </div>
        <% } %>

        <div id="upload-modal-error" class="alert alert-error text-xs py-2.5 mb-4 hidden" role="alert">
            <span id="upload-modal-error-text"></span>
        </div>

        <div id="upload-dropzone" tabindex="0" role="button" aria-label="Choose or drop an image to upload"
            class="border-2 border-dashed border-secondary/40 hover:border-accent rounded-xl p-6 text-center cursor-pointer bg-base-200/40 transition-colors focus:outline-none focus:ring-2 focus:ring-accent">
            <input id="climb-photo-file-input" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden" />
            <div id="upload-dropzone-empty" class="space-y-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mx-auto text-accent/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="17 8 12 3 7 8" />
                    <line x1="12" x2="12" y1="3" y2="15" />
                </svg>
                <p class="text-sm font-medium text-base-content">Click to choose a photo, drag &amp; drop, or paste</p>
                <p class="text-xs text-base-content/60">JPG, PNG, WebP, or GIF up to 20 MB • Hosted on Imgur</p>
            </div>
            <div id="upload-preview-wrap" class="hidden space-y-2">
                <img id="upload-preview-img" src="" alt="Selected climb photo preview" class="max-h-56 mx-auto rounded-lg object-contain my-0" />
                <p id="upload-preview-meta" class="text-xs font-mono text-base-content/70"></p>
            </div>
        </div>

        <div id="upload-modal-status" class="text-xs text-accent font-medium mt-3 hidden flex items-center gap-2">
            <span class="loading loading-spinner loading-xs"></span>
            <span id="upload-modal-status-text">Uploading to Imgur...</span>
        </div>

        <div class="modal-action mt-5 flex items-center justify-between">
            <button type="button" id="upload-clear-file-btn" class="btn btn-sm btn-ghost hidden">Clear</button>
            <div class="flex items-center gap-2 ml-auto">
                <button type="button" id="upload-cancel-btn" class="btn btn-sm btn-ghost">Cancel</button>
                <button type="button" id="upload-submit-btn" class="btn btn-sm btn-primary" disabled>
                    Upload Photo
                </button>
            </div>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop">
        <button aria-label="Close">close</button>
    </form>
</dialog>
<% } %>

<script>
(function () {
    const stateEl = document.getElementById('climb-media-state');
    const climbState = stateEl ? JSON.parse(stateEl.textContent || '{}') : {};
    const IMGUR_CLIENT_ID = <%- safeImgurClientIdJson %>;
    const LOGIN_URL = <%- JSON.stringify(safeLoginRedirectUrl).replace(/</g, '\\u003c') %>;
    const ALLOWED_MIME_TYPES = new Set(['image/jpeg', 'image/png', 'image/webp', 'image/gif']);
    const MAX_FILE_BYTES = 20 * 1024 * 1024;

    // Lightbox state & DOM
    const lightboxModal = document.getElementById('climb-media-lightbox-modal');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxTitle = document.getElementById('lightbox-climb-title');
    const lightboxMeta = document.getElementById('lightbox-meta');
    const lightboxCounter = document.getElementById('lightbox-counter');
    const lightboxPrev = document.getElementById('lightbox-prev-btn');
    const lightboxNext = document.getElementById('lightbox-next-btn');
    const lightboxOriginal = document.getElementById('lightbox-open-original');
    const lightboxDeleteBtn = document.getElementById('lightbox-delete-btn');
    const lightboxCloseBtn = document.getElementById('lightbox-close-btn');

    let activeLightboxClimbId = '';
    let activeLightboxIndex = 0;

    function renderClimbGallery(climbId) {
        const entry = climbState[climbId];
        if (!entry) return;
        const mediaList = entry.media || [];
        const wrap = document.querySelector('[data-climb-gallery-wrap="' + climbId + '"]');
        const grid = document.querySelector('[data-climb-gallery="' + climbId + '"]');
        const emptyEl = document.querySelector('[data-climb-gallery-empty="' + climbId + '"]');
        const countEl = document.querySelector('[data-climb-photo-count="' + climbId + '"]');

        if (countEl) {
            if (mediaList.length > 0) {
                const usePlain = countEl.getAttribute('data-count-plain') === 'true';
                const prefix = (!usePlain && entry.hasContributor) ? '• ' : '';
                const word = mediaList.length === 1 ? 'photo' : 'photos';
                countEl.textContent = prefix + mediaList.length + ' ' + word;
                countEl.classList.remove('hidden');
            } else {
                countEl.classList.add('hidden');
            }
        }

        if (!wrap || !grid) return;
        grid.textContent = '';

        if (mediaList.length === 0) {
            wrap.classList.add('hidden');
            if (emptyEl) emptyEl.classList.remove('hidden');
            return;
        }

        wrap.classList.remove('hidden');
        if (emptyEl) emptyEl.classList.add('hidden');

        const maxAttr = grid.getAttribute('data-max-thumbnails');
        const parsedMax = maxAttr !== null && maxAttr !== '' ? parseInt(maxAttr, 10) : 4;
        const maxThumbnails = Number.isNaN(parsedMax) ? 4 : parsedMax;
        const visible = maxThumbnails > 0 ? mediaList.slice(0, maxThumbnails) : mediaList;

        visible.forEach(function (photo, idx) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.setAttribute('data-lightbox-open', climbId);
            btn.setAttribute('data-media-id', photo.id);
            btn.setAttribute('aria-label', 'View photo of ' + (entry.name || 'climb'));
            btn.className = 'relative aspect-[4/3] w-full rounded-lg overflow-hidden border border-base-content/15 bg-base-100/70 group cursor-pointer focus:outline-none focus:ring-2 focus:ring-accent';

            const img = document.createElement('img');
            img.src = photo.url;
            img.alt = 'Photo of ' + (entry.name || 'climb');
            img.loading = 'lazy';
            img.decoding = 'async';
            img.referrerPolicy = 'no-referrer';
            img.className = 'w-full h-full object-cover my-0 group-hover:scale-105 transition-transform duration-200';
            btn.appendChild(img);

            if (maxThumbnails > 0 && idx === maxThumbnails - 1 && mediaList.length > maxThumbnails) {
                const overlay = document.createElement('span');
                overlay.className = 'absolute inset-0 bg-black/55 text-white font-mono text-xs font-bold flex items-center justify-center';
                overlay.textContent = '+' + (mediaList.length - maxThumbnails);
                btn.appendChild(overlay);
            }

            grid.appendChild(btn);
        });
    }

    function updateLightboxView() {
        const entry = climbState[activeLightboxClimbId];
        const list = entry?.media || [];
        if (!list.length || !lightboxModal) {
            if (lightboxModal && lightboxModal.open) lightboxModal.close();
            return;
        }
        if (activeLightboxIndex < 0) activeLightboxIndex = list.length - 1;
        if (activeLightboxIndex >= list.length) activeLightboxIndex = 0;

        const photo = list[activeLightboxIndex];
        lightboxTitle.textContent = entry.name || 'Climb Photo';

        const metaParts = [];
        if (photo.username) metaParts.push('Uploaded by ' + photo.username);
        if (photo.uploadTime) metaParts.push(photo.uploadTime);
        if (photo.width && photo.height) metaParts.push(photo.width + '×' + photo.height);
        lightboxMeta.textContent = metaParts.join(' • ');

        lightboxImg.src = photo.url;
        lightboxImg.alt = 'Photo of ' + (entry.name || 'climb');
        lightboxOriginal.href = photo.url;
        lightboxCounter.textContent = (activeLightboxIndex + 1) + ' / ' + list.length;

        const hasMultiple = list.length > 1;
        lightboxPrev.classList.toggle('hidden', !hasMultiple);
        lightboxNext.classList.toggle('hidden', !hasMultiple);
        lightboxDeleteBtn.classList.toggle('hidden', !photo.canDelete);
        lightboxDeleteBtn.disabled = false;
        lightboxDeleteBtn.textContent = 'Delete Photo';

        if (photo.id && window.history && window.history.replaceState) {
            const targetHash = '#photo-' + encodeURIComponent(photo.id);
            if (window.location.hash !== targetHash) {
                window.history.replaceState({ lightbox: true, climbId: activeLightboxClimbId, mediaId: photo.id }, '', targetHash);
            }
        }
    }

    function openLightbox(climbId, mediaId) {
        const entry = climbState[climbId];
        if (!entry || !entry.media || entry.media.length === 0 || !lightboxModal) return;
        activeLightboxClimbId = climbId;
        const foundIdx = entry.media.findIndex(function (m) { return m.id === mediaId; });
        activeLightboxIndex = foundIdx >= 0 ? foundIdx : 0;
        const photo = entry.media[activeLightboxIndex];
        if (photo && photo.id && window.history && window.history.pushState) {
            window.history.pushState({ lightbox: true, climbId: climbId, mediaId: photo.id }, '', '#photo-' + encodeURIComponent(photo.id));
        }
        updateLightboxView();
        if (!lightboxModal.open) {
            lightboxModal.showModal();
        }
    }

    if (lightboxModal) {
        lightboxModal.addEventListener('close', function () {
            if (window.location.hash && window.location.hash.startsWith('#photo-') && window.history && window.history.replaceState) {
                window.history.replaceState(null, '', window.location.pathname + window.location.search);
            }
        });
    }

    window.addEventListener('popstate', function () {
        if (lightboxModal && lightboxModal.open && (!window.location.hash || !window.location.hash.startsWith('#photo-'))) {
            lightboxModal.close();
            return;
        }
        if (window.location.hash && window.location.hash.startsWith('#photo-')) {
            const targetMediaId = decodeURIComponent(window.location.hash.slice(7));
            for (const cid in climbState) {
                const found = (climbState[cid]?.media || []).find(function (m) { return m.id === targetMediaId; });
                if (found) {
                    activeLightboxClimbId = cid;
                    const fIdx = climbState[cid].media.findIndex(function (m) { return m.id === targetMediaId; });
                    activeLightboxIndex = fIdx >= 0 ? fIdx : 0;
                    updateLightboxView();
                    if (lightboxModal && !lightboxModal.open) lightboxModal.showModal();
                    break;
                }
            }
        }
    });

    if (window.location.hash && window.location.hash.startsWith('#photo-')) {
        const initialMediaId = decodeURIComponent(window.location.hash.slice(7));
        for (const cid in climbState) {
            const found = (climbState[cid]?.media || []).find(function (m) { return m.id === initialMediaId; });
            if (found) {
                openLightbox(cid, initialMediaId);
                break;
            }
        }
    }

    if (lightboxCloseBtn && lightboxModal) {
        lightboxCloseBtn.addEventListener('click', function () { lightboxModal.close(); });
    }
    if (lightboxPrev) {
        lightboxPrev.addEventListener('click', function () {
            activeLightboxIndex -= 1;
            updateLightboxView();
        });
    }
    if (lightboxNext) {
        lightboxNext.addEventListener('click', function () {
            activeLightboxIndex += 1;
            updateLightboxView();
        });
    }
    if (lightboxDeleteBtn) {
        lightboxDeleteBtn.addEventListener('click', async function () {
            const entry = climbState[activeLightboxClimbId];
            const photo = entry?.media?.[activeLightboxIndex];
            if (!photo || !photo.canDelete) return;
            if (!window.confirm('Remove this photo from ' + (entry.name || 'this climb') + '?')) return;

            lightboxDeleteBtn.disabled = true;
            lightboxDeleteBtn.textContent = 'Removing...';
            try {
                const res = await fetch('/api/climbs/' + encodeURIComponent(activeLightboxClimbId) + '/media/' + encodeURIComponent(photo.id), {
                    method: 'DELETE',
                    credentials: 'same-origin'
                });
                const data = await res.json().catch(function () { return {}; });
                if (!res.ok || !data.ok) {
                    window.alert(data.message || 'Could not remove photo.');
                    lightboxDeleteBtn.disabled = false;
                    lightboxDeleteBtn.textContent = 'Delete Photo';
                    return;
                }
                entry.media = entry.media.filter(function (m) { return m.id !== photo.id; });
                renderClimbGallery(activeLightboxClimbId);
                if (entry.media.length === 0) {
                    lightboxModal.close();
                } else {
                    if (activeLightboxIndex >= entry.media.length) activeLightboxIndex = entry.media.length - 1;
                    updateLightboxView();
                }
            } catch (_) {
                window.alert('Network error while deleting photo.');
                lightboxDeleteBtn.disabled = false;
                lightboxDeleteBtn.textContent = 'Delete Photo';
            }
        });
    }

    document.addEventListener('keydown', function (e) {
        if (!lightboxModal || !lightboxModal.open) return;
        if (e.key === 'ArrowLeft') {
            activeLightboxIndex -= 1;
            updateLightboxView();
        } else if (e.key === 'ArrowRight') {
            activeLightboxIndex += 1;
            updateLightboxView();
        }
    });

    // Upload Modal state & DOM
    const uploadModal = document.getElementById('climb-media-upload-modal');
    const uploadClimbNameEl = document.getElementById('upload-modal-climb-name');
    const uploadCloseBtn = document.getElementById('upload-modal-close-btn');
    const uploadCancelBtn = document.getElementById('upload-cancel-btn');
    const uploadClearBtn = document.getElementById('upload-clear-file-btn');
    const uploadSubmitBtn = document.getElementById('upload-submit-btn');
    const uploadDropzone = document.getElementById('upload-dropzone');
    const uploadFileInput = document.getElementById('climb-photo-file-input');
    const uploadDropzoneEmpty = document.getElementById('upload-dropzone-empty');
    const uploadPreviewWrap = document.getElementById('upload-preview-wrap');
    const uploadPreviewImg = document.getElementById('upload-preview-img');
    const uploadPreviewMeta = document.getElementById('upload-preview-meta');
    const uploadErrorEl = document.getElementById('upload-modal-error');
    const uploadErrorTextEl = document.getElementById('upload-modal-error-text');
    const uploadStatusEl = document.getElementById('upload-modal-status');
    const uploadStatusTextEl = document.getElementById('upload-modal-status-text');

    let activeUploadClimbId = '';
    let activeUploadClimbName = '';
    let selectedFile = null;
    let selectedFileDims = { width: 0, height: 0 };
    let selectedPreviewObjectUrl = '';
    let isUploading = false;

    function showUploadError(msg) {
        if (!uploadErrorEl || !uploadErrorTextEl) return;
        uploadErrorTextEl.textContent = msg;
        uploadErrorEl.classList.remove('hidden');
    }

    function clearUploadError() {
        if (uploadErrorEl) uploadErrorEl.classList.add('hidden');
    }

    function setUploadStatus(visible, text) {
        if (!uploadStatusEl || !uploadStatusTextEl) return;
        if (text) uploadStatusTextEl.textContent = text;
        uploadStatusEl.classList.toggle('hidden', !visible);
    }

    function formatBytes(bytes) {
        if (!bytes) return '0 B';
        if (bytes >= 1024 * 1024) return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
        return Math.max(1, Math.round(bytes / 1024)) + ' KB';
    }

    function resetSelectedFile() {
        selectedFile = null;
        selectedFileDims = { width: 0, height: 0 };
        if (selectedPreviewObjectUrl) {
            URL.revokeObjectURL(selectedPreviewObjectUrl);
            selectedPreviewObjectUrl = '';
        }
        if (uploadFileInput) uploadFileInput.value = '';
        if (uploadPreviewImg) uploadPreviewImg.src = '';
        if (uploadPreviewMeta) uploadPreviewMeta.textContent = '';
        if (uploadDropzoneEmpty) uploadDropzoneEmpty.classList.remove('hidden');
        if (uploadPreviewWrap) uploadPreviewWrap.classList.add('hidden');
        if (uploadClearBtn) uploadClearBtn.classList.add('hidden');
        if (uploadSubmitBtn) uploadSubmitBtn.disabled = true;
    }

    function handleFileSelected(file) {
        clearUploadError();
        if (!file) return;

        if (!ALLOWED_MIME_TYPES.has(file.type)) {
            resetSelectedFile();
            showUploadError('Unsupported image format. Please choose a JPG, PNG, WebP, or GIF image.');
            return;
        }
        if (file.size > MAX_FILE_BYTES) {
            resetSelectedFile();
            showUploadError('Image exceeds the 20 MB limit (' + formatBytes(file.size) + ').');
            return;
        }

        if (selectedPreviewObjectUrl) {
            URL.revokeObjectURL(selectedPreviewObjectUrl);
        }
        selectedFile = file;
        selectedFileDims = { width: 0, height: 0 };
        selectedPreviewObjectUrl = URL.createObjectURL(file);

        if (uploadPreviewImg) {
            uploadPreviewImg.onload = function () {
                selectedFileDims = {
                    width: uploadPreviewImg.naturalWidth || 0,
                    height: uploadPreviewImg.naturalHeight || 0
                };
                if (uploadPreviewMeta) {
                    const dimLabel = selectedFileDims.width && selectedFileDims.height
                        ? ' • ' + selectedFileDims.width + '×' + selectedFileDims.height
                        : '';
                    uploadPreviewMeta.textContent = file.name + ' (' + formatBytes(file.size) + dimLabel + ')';
                }
            };
            uploadPreviewImg.src = selectedPreviewObjectUrl;
        }

        if (uploadPreviewMeta) {
            uploadPreviewMeta.textContent = file.name + ' (' + formatBytes(file.size) + ')';
        }
        if (uploadDropzoneEmpty) uploadDropzoneEmpty.classList.add('hidden');
        if (uploadPreviewWrap) uploadPreviewWrap.classList.remove('hidden');
        if (uploadClearBtn) uploadClearBtn.classList.remove('hidden');
        if (uploadSubmitBtn) uploadSubmitBtn.disabled = !IMGUR_CLIENT_ID;
    }

    function fileToBase64(file) {
        return new Promise(function (resolve, reject) {
            const reader = new FileReader();
            reader.onload = function () {
                const raw = String(reader.result || '');
                const commaIdx = raw.indexOf(',');
                resolve(commaIdx >= 0 ? raw.slice(commaIdx + 1) : raw);
            };
            reader.onerror = function () { reject(new Error('Could not read file.')); };
            reader.readAsDataURL(file);
        });
    }

    async function uploadDirectToImgur(file, title) {
        const fd = new FormData();
        fd.append('image', file);
        if (title) fd.append('title', title.slice(0, 120));

        const res = await fetch('https://api.imgur.com/3/image', {
            method: 'POST',
            referrerPolicy: 'no-referrer',
            headers: {
                Authorization: 'Client-ID ' + IMGUR_CLIENT_ID
            },
            body: fd
        });

        const json = await res.json().catch(function () { return null; });
        if (!res.ok || !json || !json.success || !json.data || !json.data.link) {
            const errMsg = json?.data?.error?.message || json?.data?.error || ('Imgur upload failed (' + res.status + ').');
            const err = new Error(String(errMsg));
            err.status = res.status;
            throw err;
        }
        return json.data;
    }

    async function saveUploadedPhoto() {
        if (!selectedFile || !activeUploadClimbId || isUploading) return;
        if (!IMGUR_CLIENT_ID) {
            showUploadError('Imgur Client-ID is not configured on the server.');
            return;
        }

        isUploading = true;
        clearUploadError();
        uploadSubmitBtn.disabled = true;
        if (uploadClearBtn) uploadClearBtn.disabled = true;
        setUploadStatus(true, 'Uploading image to Imgur...');

        try {
            let serverPayload = null;
            try {
                const imgurData = await uploadDirectToImgur(selectedFile, activeUploadClimbName);
                const mime = String(imgurData.type || selectedFile.type || '');
                const format = mime.includes('/') ? mime.split('/')[1] : '';
                serverPayload = {
                    mediaUrl: imgurData.link,
                    width: imgurData.width || selectedFileDims.width || 0,
                    height: imgurData.height || selectedFileDims.height || 0,
                    size: imgurData.size || selectedFile.size || 0,
                    format: format,
                    imgurId: imgurData.id || ''
                };
            } catch (directErr) {
                // Local dev origins (localhost / 127.0.0.1) or CORS blocks may get 403 from Imgur; fallback via server
                const shouldFallbackToServer = !directErr.status || directErr.status === 403 || directErr.status === 429;
                if (!shouldFallbackToServer) {
                    throw directErr;
                }
                setUploadStatus(true, 'Retrying upload via server...');
                const base64 = await fileToBase64(selectedFile);
                serverPayload = { imageBase64: base64 };
            }

            setUploadStatus(true, 'Saving photo to climb...');
            const saveRes = await fetch('/api/climbs/' + encodeURIComponent(activeUploadClimbId) + '/media', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(serverPayload)
            });
            const saveJson = await saveRes.json().catch(function () { return {}; });
            if (saveRes.status === 401) {
                window.location.href = LOGIN_URL;
                return;
            }
            if (!saveRes.ok || !saveJson.ok || !saveJson.media) {
                throw new Error(saveJson.message || 'Could not save photo.');
            }

            if (!climbState[activeUploadClimbId]) {
                climbState[activeUploadClimbId] = { name: activeUploadClimbName, hasContributor: false, media: [] };
            }
            climbState[activeUploadClimbId].media.unshift(saveJson.media);
            renderClimbGallery(activeUploadClimbId);

            resetSelectedFile();
            uploadModal.close();
        } catch (err) {
            showUploadError(err?.message || 'Upload failed. Please try again.');
        } finally {
            isUploading = false;
            setUploadStatus(false);
            if (uploadClearBtn) uploadClearBtn.disabled = false;
            if (uploadSubmitBtn) uploadSubmitBtn.disabled = !selectedFile || !IMGUR_CLIENT_ID;
        }
    }

    if (uploadModal) {
        function closeUploadModal() {
            if (isUploading) return;
            resetSelectedFile();
            clearUploadError();
            setUploadStatus(false);
            uploadModal.close();
        }

        if (uploadCloseBtn) uploadCloseBtn.addEventListener('click', closeUploadModal);
        if (uploadCancelBtn) uploadCancelBtn.addEventListener('click', closeUploadModal);
        uploadModal.addEventListener('cancel', function (e) {
            if (isUploading) e.preventDefault();
        });
        if (uploadClearBtn) uploadClearBtn.addEventListener('click', function () {
            clearUploadError();
            resetSelectedFile();
        });
        if (uploadSubmitBtn) uploadSubmitBtn.addEventListener('click', saveUploadedPhoto);

        if (uploadDropzone && uploadFileInput) {
            uploadDropzone.addEventListener('click', function () {
                if (!isUploading) uploadFileInput.click();
            });
            uploadDropzone.addEventListener('keydown', function (e) {
                if ((e.key === 'Enter' || e.key === ' ') && !isUploading) {
                    e.preventDefault();
                    uploadFileInput.click();
                }
            });
            uploadDropzone.addEventListener('dragover', function (e) {
                e.preventDefault();
                uploadDropzone.classList.add('border-accent', 'bg-base-200');
            });
            uploadDropzone.addEventListener('dragleave', function () {
                uploadDropzone.classList.remove('border-accent', 'bg-base-200');
            });
            uploadDropzone.addEventListener('drop', function (e) {
                e.preventDefault();
                uploadDropzone.classList.remove('border-accent', 'bg-base-200');
                const file = e.dataTransfer?.files?.[0];
                if (file) handleFileSelected(file);
            });
            uploadFileInput.addEventListener('change', function () {
                const file = uploadFileInput.files?.[0];
                if (file) handleFileSelected(file);
            });
        }

        document.addEventListener('paste', function (e) {
            if (!uploadModal.open || isUploading) return;
            const items = e.clipboardData?.items || [];
            for (let i = 0; i < items.length; i++) {
                if (items[i].type && items[i].type.startsWith('image/')) {
                    const pastedFile = items[i].getAsFile();
                    if (pastedFile) {
                        handleFileSelected(pastedFile);
                        break;
                    }
                }
            }
        });
    }

    // Delegated click handlers for opening Lightbox and Upload Modal
    document.addEventListener('click', function (e) {
        const lightboxBtn = e.target.closest ? e.target.closest('[data-lightbox-open]') : null;
        if (lightboxBtn) {
            const cid = lightboxBtn.getAttribute('data-lightbox-open') || '';
            const mid = lightboxBtn.getAttribute('data-media-id') || '';
            openLightbox(cid, mid);
            return;
        }

        const uploadBtn = e.target.closest ? e.target.closest('[data-upload-climb-id]') : null;
        if (uploadBtn && uploadModal) {
            activeUploadClimbId = uploadBtn.getAttribute('data-upload-climb-id') || '';
            activeUploadClimbName = uploadBtn.getAttribute('data-upload-climb-name') || 'Climb';
            if (uploadClimbNameEl) uploadClimbNameEl.textContent = activeUploadClimbName;
            resetSelectedFile();
            clearUploadError();
            setUploadStatus(false);
            uploadModal.showModal();
        }
    });
})();
</script>

