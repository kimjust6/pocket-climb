<%
    const climbs = areaView.climbs || [];
    if (!climbs || climbs.length === 0) return;
    const minimalClimbs = climbs.map(cl => ({
        id: cl.id,
        name: cl.name,
        url: cl.url,
        fa: cl.fa || '',
        subAreaName: cl.subAreaName || '',
        subAreaUrl: cl.subAreaUrl || '',
        allGrades: cl.allGrades || [],
        primaryGrade: cl.primaryGrade || '',
        safety: cl.safety || '',
        difficultyTier: cl.difficultyTier || '',
        difficultyRank: cl.difficultyRank || 0,
        disciplines: cl.disciplines || [],
        length: cl.length || 0,
        pitchesCount: cl.pitchesCount || 0,
        boltsCount: cl.boltsCount || 0,
        hasCoords: cl.hasCoords || false,
        lat: cl.lat || 0,
        lng: cl.lng || 0,
        description: cl.description ? (cl.description.length > 200 ? cl.description.slice(0, 200) + '...' : cl.description) : '',
        descriptionHtml: cl.descriptionHtml ? (cl.descriptionHtml.length > 300 ? cl.descriptionHtml.slice(0, 300) + '...' : cl.descriptionHtml) : '',
        locationHtml: cl.locationHtml || '',
        media: (cl.media || []).slice(0, 4).map(m => ({ id: m.id, url: m.url })),
        createdByUser: cl.createdByUser || ''
    }));
    const safeClimbsJson = JSON.stringify(minimalClimbs).replace(/</g, '\\u003c');
    const safeAuthJson = JSON.stringify({
        isAuthenticated: areaView.isAuthenticated,
        canonicalPath: areaView.canonicalPath
    }).replace(/</g, '\\u003c');
%>
<script id="area-climbs-island-data" type="application/json"><%- safeClimbsJson %></script>
<script id="area-climbs-auth-data" type="application/json"><%- safeAuthJson %></script>

<section id="area-climbs-island" class="not-prose" aria-labelledby="heading-climbs">
    <!-- Header with Dynamic or SSR title -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-3 mb-3">
        <div>
            <h2 id="heading-climbs" class="text-2xl font-bold text-base-content my-0">
                <% if (areaView.isDescendantClimbs) { %>
                    Featured Climbs in <%= areaView.name %> (<%= climbs.length %>)
                <% } else { %>
                    Climbs &amp; Routes (<%= climbs.length %>)
                <% } %>
            </h2>
            <p class="text-xs text-base-content/60 my-0 mt-0.5">
                Rock climbing routes, boulder problems, and crag beta
            </p>
        </div>

        <!-- View Mode Switcher (Vue Enhanced) -->
        <div v-cloak v-if="isMounted" class="flex items-center gap-2 self-start md:self-auto">
            <span class="text-xs text-base-content/60 font-mono hidden sm:inline">View:</span>
            <div class="join border border-base-content/20 rounded-lg overflow-hidden bg-base-100">
                <button
                    type="button"
                    @click="viewMode = 'grid'"
                    class="btn btn-xs join-item"
                    :class="viewMode === 'grid' ? 'btn-accent text-accent-content font-bold' : 'btn-ghost text-base-content/70'"
                    aria-label="Grid card view"
                    title="Grid card view"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
                    <span class="hidden sm:inline">Cards</span>
                </button>
                <button
                    type="button"
                    @click="viewMode = 'compact'"
                    class="btn btn-xs join-item"
                    :class="viewMode === 'compact' ? 'btn-accent text-accent-content font-bold' : 'btn-ghost text-base-content/70'"
                    aria-label="Compact list view"
                    title="Compact list view"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" x2="21" y1="6" y2="6"/><line x1="3" x2="21" y1="12" y2="12"/><line x1="3" x2="21" y1="18" y2="18"/></svg>
                    <span class="hidden sm:inline">List</span>
                </button>
            </div>
        </div>
    </div>
    <hr class="mb-4 border-t-2 border-base-content" />

    <!-- Interactive Filter & Sort Toolbar (Vue Enhanced Island) -->
    <div v-cloak v-if="isMounted" class="card dark:bg-base-300/70 bg-base-300/60 backdrop-blur border border-secondary/20 rounded-2xl p-4 sm:p-5 mb-6 shadow-md space-y-3.5">
        <!-- Top Row: Search Input + Sorting + Grade Filter -->
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-3">
            <!-- Live Search Input -->
            <div class="sm:col-span-5 relative">
                <input
                    type="text"
                    role="searchbox"
                    v-model="searchQuery"
                    placeholder="Search climbs by name, FA, or beta..."
                    class="input input-bordered input-sm w-full rounded-xl bg-base-100 border-base-content/25 pl-9 pr-8 text-xs focus:outline-none focus:ring-2 focus:ring-accent"
                    aria-label="Filter climbs by keyword"
                />
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-base-content/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <button
                    v-if="searchQuery"
                    @click="searchQuery = ''"
                    type="button"
                    class="btn btn-ghost btn-xs btn-circle absolute right-1.5 top-1/2 -translate-y-1/2 text-base-content/60 hover:text-base-content h-6 w-6 min-h-0 text-xs"
                    aria-label="Clear climb search"
                >
                    ✕
                </button>
            </div>

            <!-- Grade Tier Filter Dropdown -->
            <div class="sm:col-span-4">
                <select
                    v-model="gradeTierFilter"
                    class="select select-bordered select-sm w-full rounded-xl bg-base-100 border-base-content/25 text-xs focus:outline-none focus:ring-2 focus:ring-accent font-medium"
                    aria-label="Filter by difficulty tier"
                >
                    <option value="ALL">All Difficulties</option>
                    <option value="Beginner">Beginner (≤ 5.7 / VB-V0)</option>
                    <option value="Intermediate">Intermediate (5.8 – 5.10d / V1-V4)</option>
                    <option value="Advanced">Advanced (5.11a – 5.12d / V5-V8)</option>
                    <option value="Expert">Expert (5.13a – 5.13d / V9-V12)</option>
                    <option value="Elite">Elite (5.14+ / V13+)</option>
                </select>
            </div>

            <!-- Sort By Dropdown -->
            <div class="sm:col-span-3">
                <select
                    v-model="sortBy"
                    class="select select-bordered select-sm w-full rounded-xl bg-base-100 border-base-content/25 text-xs focus:outline-none focus:ring-2 focus:ring-accent font-medium"
                    aria-label="Sort climbs"
                >
                    <option value="default">Default Order</option>
                    <option value="name-asc">Name (A → Z)</option>
                    <option value="grade-asc">Grade (Easiest First)</option>
                    <option value="grade-desc">Grade (Hardest First)</option>
                    <option value="length-desc">Length (Tallest First)</option>
                    <option value="pitches-desc">Pitches (Most First)</option>
                </select>
            </div>
        </div>

        <!-- Bottom Row: Discipline Pills + Summary Reset -->
        <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-base-content/10">
            <!-- Discipline Filter Pills -->
            <div class="flex flex-wrap items-center gap-1.5">
                <button
                    type="button"
                    @click="disciplineFilter = 'ALL'"
                    class="badge badge-sm py-2 px-2.5 font-medium transition-all cursor-pointer border"
                    :class="disciplineFilter === 'ALL' ? 'bg-secondary text-secondary-content border-secondary font-bold shadow-sm' : 'bg-base-100 border-base-content/20 text-base-content hover:bg-base-content hover:text-base-100'"
                >
                    All Disciplines ({{ allClimbs.length }})
                </button>
                <button
                    v-for="disc in availableDisciplines"
                    :key="disc.name"
                    type="button"
                    @click="disciplineFilter = disc.name"
                    class="badge badge-sm py-2 px-2.5 font-medium uppercase text-[10px] tracking-wider transition-all cursor-pointer border"
                    :class="disciplineFilter === disc.name ? 'bg-accent text-accent-content border-accent font-bold shadow-sm' : 'bg-base-100 border-base-content/20 text-base-content hover:bg-base-content hover:text-base-100'"
                >
                    {{ disc.label }} ({{ disc.count }})
                </button>
            </div>

            <!-- Filter Status & Reset Action -->
            <div class="flex items-center gap-2 text-xs text-base-content/70 font-mono">
                <span>Showing <strong>{{ filteredClimbs.length }}</strong> of {{ allClimbs.length }}</span>
                <button
                    v-if="hasActiveFilters"
                    type="button"
                    @click="resetAllFilters"
                    class="btn btn-ghost btn-xs text-accent hover:underline p-0 h-auto min-h-0 font-sans"
                >
                    Reset
                </button>
            </div>
        </div>
    </div>

    <!-- SSR Fallback (Crawlers, SEO, Social Crawlers & No-JS) -->
    <div v-if="!isMounted" class="ssr-climbs-fallback overflow-x-auto card dark:bg-base-300/70 bg-base-300/60 border border-secondary/20 rounded-2xl shadow-sm my-4">
        <table class="table table-sm w-full">
            <thead>
                <tr class="border-b border-base-content/10 text-secondary text-xs uppercase tracking-wider font-bold">
                    <th>Route Name</th>
                    <th>Grade</th>
                    <th>Discipline</th>
                    <th class="hidden sm:table-cell">Length</th>
                    <th class="hidden md:table-cell">Location</th>
                </tr>
            </thead>
            <tbody>
                <% climbs.forEach(climb => { %>
                    <tr class="border-b border-base-content/5">
                        <td class="font-semibold">
                            <a href="<%= climb.url %>" class="text-secondary hover:text-accent font-bold no-underline">
                                <%= climb.name %>
                            </a>
                            <% if (climb.subAreaName && climb.subAreaUrl) { %>
                                <a href="<%= climb.subAreaUrl %>" class="block text-[11px] text-base-content/60 font-normal hover:underline no-underline">
                                    📍 <%= climb.subAreaName %>
                                </a>
                            <% } %>
                        </td>
                        <td>
                            <span class="badge badge-accent badge-sm font-mono font-bold"><%= climb.primaryGrade || '—' %></span>
                            <% if (climb.safety) { %>
                                <span class="badge badge-warning badge-xs font-mono ml-1"><%= climb.safety %></span>
                            <% } %>
                        </td>
                        <td>
                            <div class="flex flex-wrap gap-1">
                                <% (climb.disciplines || []).forEach(disc => { %>
                                    <span class="badge badge-xs bg-base-100 border border-base-content/20 uppercase text-[9px]"><%= disc %></span>
                                <% }); %>
                            </div>
                        </td>
                        <td class="font-mono text-xs hidden sm:table-cell">
                            <%= climb.length > 0 ? climb.length + 'm' : '—' %>
                        </td>
                        <td class="text-xs text-base-content/70 hidden md:table-cell">
                            <%= climb.subAreaName || areaView.name %>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>

    <!-- Vue-Enhanced Reactive Climbs View -->
    <div v-cloak v-if="isMounted" class="vue-climbs-view">
        <!-- 0 Matches Empty State -->
        <div v-if="filteredClimbs.length === 0" class="card dark:bg-base-300/70 bg-base-300/60 border border-secondary/20 rounded-2xl p-8 text-center my-6">
            <h3 class="text-xl font-bold text-accent my-0 mb-2">No climbing routes match your filters</h3>
            <p class="text-sm text-base-content/80 my-0 mb-4 max-w-md mx-auto">
                We couldn't find any routes in <%= areaView.name %> matching your current search and difficulty filters.
            </p>
            <div>
                <button type="button" @click="resetAllFilters" class="btn btn-accent btn-sm rounded-xl">
                    Clear All Filters
                </button>
            </div>
        </div>

        <!-- Mode A: Grid Cards View -->
        <div v-else-if="viewMode === 'grid'" class="grid gap-4 md:grid-cols-2">
            <div
                v-for="climb in filteredClimbs"
                :key="climb.id"
                :id="'climb-' + climb.id"
                class="card dark:bg-base-300/70 bg-base-300/60 border border-secondary/20 rounded-xl p-5 shadow-sm flex flex-col justify-between scroll-mt-24 transition-all duration-200"
            >
                <div>
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <h3 class="text-lg font-bold text-secondary mt-0 mb-0">
                                <a :href="climb.url" class="text-secondary hover:text-accent transition-colors no-underline">
                                    {{ climb.name }}
                                </a>
                            </h3>
                            <a
                                v-if="climb.subAreaName && climb.subAreaUrl"
                                :href="climb.subAreaUrl"
                                class="inline-block text-xs text-accent hover:underline font-medium mt-0.5 no-underline"
                            >
                                📍 {{ climb.subAreaName }}
                            </a>
                            <p v-if="climb.fa" class="text-xs text-base-content/60 mt-0.5 my-0">
                                FA: {{ climb.fa }}
                            </p>
                        </div>

                        <!-- Grades & Safety -->
                        <div class="flex flex-wrap items-center justify-end gap-1.5 shrink-0">
                            <template v-if="climb.allGrades && climb.allGrades.length > 0">
                                <a
                                    v-for="(g, gIdx) in climb.allGrades"
                                    :key="g.system + g.value"
                                    :href="'/?query=' + encodeURIComponent(g.value)"
                                    class="badge font-mono no-underline hover:bg-base-content hover:text-base-100 transition-all duration-200 cursor-pointer"
                                    :class="gIdx === 0 ? 'badge-accent font-bold' : 'badge-outline border-accent/40 text-base-content/80 badge-sm'"
                                    :title="g.system + ' Grade'"
                                >
                                    {{ g.value }}
                                </a>
                            </template>
                            <a
                                v-else-if="climb.primaryGrade"
                                :href="'/?query=' + encodeURIComponent(climb.primaryGrade)"
                                class="badge badge-accent font-mono font-bold no-underline hover:bg-base-content hover:text-base-100 transition-all duration-200 cursor-pointer"
                            >
                                {{ climb.primaryGrade }}
                            </a>
                            <span v-if="climb.safety" class="badge badge-warning badge-sm font-mono">
                                {{ climb.safety }}
                            </span>
                        </div>
                    </div>

                    <!-- Disciplines, Length, Coordinates -->
                    <div class="flex flex-wrap items-center gap-2 mt-3">
                        <a
                            v-for="disc in climb.disciplines || []"
                            :key="disc"
                            :href="'/?query=' + encodeURIComponent(disc)"
                            class="badge badge-sm bg-base-100/70 border border-accent/30 text-base-content uppercase text-[10px] tracking-wider no-underline hover:bg-base-content hover:text-base-100 transition-all duration-200 cursor-pointer"
                        >
                            {{ disc }}
                        </a>
                        <span v-if="climb.length > 0" class="text-xs text-base-content/70 font-mono">
                            {{ climb.length }}m
                        </span>
                        <span v-if="climb.pitchesCount > 1" class="text-xs text-base-content/70 font-mono">
                            • {{ climb.pitchesCount }} pitches
                        </span>
                        <span v-if="climb.boltsCount > 0" class="text-xs text-base-content/70 font-mono">
                            • {{ climb.boltsCount }} bolts
                        </span>
                        <a
                            v-if="climb.hasCoords"
                            :href="'https://www.google.com/maps/search/?api=1&query=' + climb.lat + ',' + climb.lng"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-xs text-accent hover:underline font-mono inline-flex items-center gap-1 ml-auto"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" /></svg>
                            {{ climb.lat.toFixed(4) }}, {{ climb.lng.toFixed(4) }}
                        </a>
                    </div>

                    <!-- Beta previews -->
                    <div v-if="climb.descriptionHtml" class="text-sm text-base-content/90 mt-3 markdown-content space-y-2 leading-relaxed" v-html="climb.descriptionHtml"></div>
                    <div v-if="climb.locationHtml" class="text-xs text-base-content/80 mt-2.5">
                        <span class="font-bold text-secondary">Location: </span>
                        <span class="markdown-content leading-relaxed" v-html="climb.locationHtml"></span>
                    </div>

                    <!-- Photo Thumbnails -->
                    <div v-if="climb.media && climb.media.length > 0" :data-climb-gallery-wrap="climb.id" class="mt-3">
                        <div :data-climb-gallery="climb.id" class="grid grid-cols-3 sm:grid-cols-4 gap-2">
                            <button
                                v-for="(photo, pIdx) in climb.media.slice(0, 4)"
                                :key="photo.id"
                                type="button"
                                :data-lightbox-open="climb.id"
                                :data-media-id="photo.id"
                                class="relative aspect-[4/3] w-full rounded-lg overflow-hidden border border-base-content/15 bg-base-100/70 group cursor-pointer focus:outline-none focus:ring-2 focus:ring-accent"
                                :aria-label="'View photo of ' + climb.name"
                            >
                                <img
                                    :src="photo.url"
                                    :alt="'Photo of ' + climb.name"
                                    loading="lazy"
                                    decoding="async"
                                    referrerpolicy="no-referrer"
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200"
                                />
                                <span
                                    v-if="pIdx === 3 && climb.media.length > 4"
                                    class="absolute inset-0 bg-black/55 text-white font-mono text-xs font-bold flex items-center justify-center"
                                >
                                    +{{ climb.media.length - 4 }}
                                </span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Footer Card Action / Contributor -->
                <div class="mt-3 pt-2.5 border-t border-base-content/10 flex flex-wrap items-center justify-between gap-2 text-[11px] text-base-content/60 font-mono">
                    <div class="flex flex-wrap items-center gap-2">
                        <span v-if="climb.createdByUser">Contributor: {{ climb.createdByUser }}</span>
                        <span v-if="climb.media && climb.media.length > 0" :data-climb-photo-count="climb.id">
                            {{ climb.createdByUser ? '• ' : '' }}{{ climb.media.length }} {{ climb.media.length === 1 ? 'photo' : 'photos' }}
                        </span>
                    </div>

                    <button
                        v-if="auth.isAuthenticated"
                        type="button"
                        :data-upload-climb-id="climb.id"
                        :data-upload-climb-name="climb.name"
                        class="btn btn-xs btn-outline border-accent/40 text-accent hover:bg-accent hover:text-accent-content hover:border-accent gap-1 rounded-lg font-sans font-medium ml-auto"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z" />
                            <circle cx="12" cy="13" r="3" />
                        </svg>
                        Add Photo
                    </button>
                    <a
                        v-else
                        :href="'/login?redirect=' + encodeURIComponent(auth.canonicalPath + '#climb-' + climb.id)"
                        class="font-sans font-medium text-accent/80 hover:text-accent hover:underline no-underline ml-auto"
                    >
                        Sign in to add photo
                    </a>
                </div>
            </div>
        </div>

        <!-- Mode B: Compact Table / List View -->
        <div v-else class="overflow-x-auto card dark:bg-base-300/70 bg-base-300/60 border border-secondary/20 rounded-2xl shadow-sm">
            <table class="table table-sm w-full">
                <thead>
                    <tr class="border-b border-base-content/10 text-secondary text-xs uppercase tracking-wider font-bold">
                        <th>Route Name</th>
                        <th>Grade</th>
                        <th>Discipline</th>
                        <th class="hidden sm:table-cell">Length</th>
                        <th class="hidden md:table-cell">Pitches</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr
                        v-for="climb in filteredClimbs"
                        :key="climb.id"
                        class="hover:bg-base-200/50 border-b border-base-content/5 transition-colors"
                    >
                        <td class="font-semibold text-secondary">
                            <a :href="climb.url" class="hover:text-accent no-underline font-bold">
                                {{ climb.name }}
                            </a>
                            <a
                                v-if="climb.subAreaName && climb.subAreaUrl"
                                :href="climb.subAreaUrl"
                                class="block text-[11px] text-base-content/60 font-normal hover:underline no-underline"
                            >
                                📍 {{ climb.subAreaName }}
                            </a>
                        </td>
                        <td>
                            <a
                                v-if="climb.primaryGrade"
                                :href="'/?query=' + encodeURIComponent(climb.primaryGrade)"
                                class="badge badge-accent badge-sm font-mono font-bold no-underline hover:bg-base-content hover:text-base-100 transition-all cursor-pointer"
                            >
                                {{ climb.primaryGrade }}
                            </a>
                            <span v-if="climb.safety" class="badge badge-warning badge-xs font-mono ml-1">
                                {{ climb.safety }}
                            </span>
                        </td>
                        <td>
                            <div class="flex flex-wrap gap-1">
                                <span
                                    v-for="disc in climb.disciplines || []"
                                    :key="disc"
                                    class="badge badge-xs bg-base-100 border border-base-content/20 uppercase text-[9px]"
                                >
                                    {{ disc }}
                                </span>
                            </div>
                        </td>
                        <td class="font-mono text-xs hidden sm:table-cell">
                            {{ climb.length > 0 ? climb.length + 'm' : '—' }}
                        </td>
                        <td class="font-mono text-xs hidden md:table-cell">
                            {{ climb.pitchesCount > 0 ? climb.pitchesCount : 1 }}
                        </td>
                        <td class="text-right">
                            <div class="flex items-center justify-end gap-1.5">
                                <button
                                    v-if="climb.media && climb.media.length > 0"
                                    type="button"
                                    :data-lightbox-open="climb.id"
                                    :data-media-id="climb.media[0].id"
                                    class="btn btn-ghost btn-xs text-accent gap-1"
                                    title="View Photos"
                                >
                                    📷 {{ climb.media.length }}
                                </button>
                                <a :href="climb.url" class="btn btn-ghost btn-xs text-secondary hover:text-accent font-medium">
                                    Beta →
                                </a>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

<script>
(function () {
    if (typeof Vue === 'undefined') return;
    const { createApp, ref, computed, watch, onMounted } = Vue;

    const rootEl = document.getElementById('area-climbs-island');
    if (!rootEl || rootEl.__vue_app__) return;

    const climbsDataEl = document.getElementById('area-climbs-island-data');
    const authDataEl = document.getElementById('area-climbs-auth-data');

    let initialClimbs = [];
    let initialAuth = { isAuthenticated: false, canonicalPath: '/' };

    if (climbsDataEl) {
        try { initialClimbs = JSON.parse(climbsDataEl.textContent || '[]'); } catch (_) {}
    }
    if (authDataEl) {
        try { initialAuth = JSON.parse(authDataEl.textContent || '{}'); } catch (_) {}
    }

    const router = window.appRouter || (typeof VueRouter !== 'undefined' ? VueRouter.createRouter({
        history: VueRouter.createWebHistory(),
        routes: [{ path: '/:pathMatch(.*)*', component: { render: () => null } }]
    }) : null);

    const app = createApp({
        setup() {
            const isMounted = ref(false);
            const allClimbs = ref(initialClimbs);
            const auth = ref(initialAuth);

            let route = null;
            let routerInstance = null;
            if (typeof VueRouter !== 'undefined') {
                try {
                    route = VueRouter.useRoute();
                    routerInstance = VueRouter.useRouter();
                } catch (_) {}
            }

            const initialQ = (route && route.query && typeof route.query.climb_q === 'string')
                ? route.query.climb_q
                : '';
            const initialDisc = (route && route.query && typeof route.query.disc === 'string')
                ? route.query.disc
                : 'ALL';
            const initialTier = (route && route.query && typeof route.query.tier === 'string')
                ? route.query.tier
                : 'ALL';
            const initialSort = (route && route.query && typeof route.query.sort === 'string')
                ? route.query.sort
                : 'default';

            const searchQuery = ref(initialQ);
            const disciplineFilter = ref(initialDisc);
            const gradeTierFilter = ref(initialTier);
            const sortBy = ref(initialSort);
            const viewMode = ref('grid');

            onMounted(() => {
                isMounted.value = true;
                try {
                    const savedView = localStorage.getItem('wiki_bloc_view_mode');
                    if (savedView === 'grid' || savedView === 'compact') {
                        viewMode.value = savedView;
                    }
                } catch (_) {}
            });

            if (route) {
                watch(() => route.query.climb_q, (newQ) => {
                    if (typeof newQ === 'string' && newQ !== searchQuery.value) {
                        searchQuery.value = newQ;
                    }
                });
                watch(() => route.query.disc, (newD) => {
                    if (typeof newD === 'string' && newD !== disciplineFilter.value) {
                        disciplineFilter.value = newD;
                    }
                });
                watch(() => route.query.tier, (newT) => {
                    if (typeof newT === 'string' && newT !== gradeTierFilter.value) {
                        gradeTierFilter.value = newT;
                    }
                });
            }

            // Extract unique disciplines with route counts
            const availableDisciplines = computed(() => {
                const map = {};
                allClimbs.value.forEach(cl => {
                    (cl.disciplines || []).forEach(d => {
                        const k = d.toLowerCase();
                        map[k] = (map[k] || 0) + 1;
                    });
                });
                return Object.keys(map).map(k => ({
                    name: k,
                    label: k,
                    count: map[k]
                })).sort((a, b) => b.count - a.count);
            });

            const hasActiveFilters = computed(() => {
                return searchQuery.value.trim() !== '' ||
                    disciplineFilter.value !== 'ALL' ||
                    gradeTierFilter.value !== 'ALL' ||
                    sortBy.value !== 'default';
            });

            function resetAllFilters() {
                searchQuery.value = '';
                disciplineFilter.value = 'ALL';
                gradeTierFilter.value = 'ALL';
                sortBy.value = 'default';
            }

            const filteredClimbs = computed(() => {
                const q = searchQuery.value.trim().toLowerCase();
                const disc = disciplineFilter.value.toLowerCase();
                const tier = gradeTierFilter.value;
                const sort = sortBy.value;

                let list = allClimbs.value.filter(cl => {
                    // Discipline filter
                    if (disc !== 'all') {
                        const clDiscs = (cl.disciplines || []).map(d => d.toLowerCase());
                        if (!clDiscs.includes(disc)) return false;
                    }

                    // Grade Tier filter
                    if (tier !== 'ALL') {
                        if (cl.difficultyTier !== tier) return false;
                    }

                    // Search query
                    if (q) {
                        const nameMatch = (cl.name || '').toLowerCase().includes(q);
                        const faMatch = (cl.fa || '').toLowerCase().includes(q);
                        const subMatch = (cl.subAreaName || '').toLowerCase().includes(q);
                        const gradeMatch = (cl.primaryGrade || '').toLowerCase().includes(q);
                        const descMatch = (cl.description || '').toLowerCase().includes(q);
                        if (!nameMatch && !faMatch && !subMatch && !gradeMatch && !descMatch) {
                            return false;
                        }
                    }

                    return true;
                });

                // Sorting
                if (sort === 'name-asc') {
                    list = [...list].sort((a, b) => (a.name || '').localeCompare(b.name || ''));
                } else if (sort === 'grade-asc') {
                    list = [...list].sort((a, b) => (a.difficultyRank || 0) - (b.difficultyRank || 0));
                } else if (sort === 'grade-desc') {
                    list = [...list].sort((a, b) => (b.difficultyRank || 0) - (a.difficultyRank || 0));
                } else if (sort === 'length-desc') {
                    list = [...list].sort((a, b) => (b.length || 0) - (a.length || 0));
                } else if (sort === 'pitches-desc') {
                    list = [...list].sort((a, b) => (b.pitchesCount || 0) - (a.pitchesCount || 0));
                }

                return list;
            });

            return {
                isMounted,
                allClimbs,
                auth,
                searchQuery,
                disciplineFilter,
                gradeTierFilter,
                sortBy,
                viewMode,
                availableDisciplines,
                hasActiveFilters,
                filteredClimbs,
                resetAllFilters
            };
        }
    });

    if (router) {
        try { app.use(router); } catch (_) {}
    }
    app.mount(rootEl);
})();
</script>

