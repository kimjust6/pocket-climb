<script server>
  // Data is passed in as locals: areas, buildAreaUrl
  response.header('Content-Type', 'application/xml; charset=utf-8')

  const latestAreaUpdate = (areas && areas.length > 0 && areas[0].getString('updated'))
    ? (new Date(areas[0].getString('updated')).toISOString().split('.')[0] + 'Z')
    : (new Date().toISOString().split('.')[0] + 'Z')

  const staticPages = [
    { loc: 'https://wiki-bloc.jkim.win/', lastmod: latestAreaUpdate, priority: '1.00', changefreq: 'weekly' },
  ]

  const xmlStaticPages = staticPages.map(({ loc, lastmod, priority, changefreq }) =>
    `<url>
    <loc>${loc}</loc>
    <lastmod>${lastmod}</lastmod>
    <changefreq>${changefreq}</changefreq>
    <priority>${priority}</priority>
  </url>`
  ).join('\n  ')

  const xmlAreas = (areas || [])
    .map(
      (area) => {
        const lastmod = area?.getString('updated')
          ? (new Date(area.getString('updated')).toISOString().split('.')[0] + 'Z')
          : latestAreaUpdate
        const path = buildAreaUrl(area?.id, area?.getString('name'))
        return `<url>
    <loc>https://wiki-bloc.jkim.win${path}</loc>
    <lastmod>${lastmod}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.80</priority>
  </url>`
      }
    )
    .join('\n  ')

  const xmlSnippet = `<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  ${xmlStaticPages}
  ${xmlAreas}
</urlset>`

  response.write(xmlSnippet)
</script>
