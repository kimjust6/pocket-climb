<script server>
  // Data is passed in as locals: areas, buildAreaUrl, baseUrl
  response.header('Content-Type', 'application/xml; charset=utf-8')

  const origin = String(typeof baseUrl !== 'undefined' && baseUrl ? baseUrl : 'https://wiki-bloc.jkim.win').replace(/\/+$/, '')
  const escapeXml = (str) => String(str || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&apos;')

  const latestAreaUpdate = (areas && areas.length > 0 && areas[0].getString('updated'))
    ? (new Date(areas[0].getString('updated')).toISOString().split('.')[0] + 'Z')
    : (new Date().toISOString().split('.')[0] + 'Z')

  const staticPages = [
    { loc: `${origin}/`, lastmod: latestAreaUpdate, priority: '1.00', changefreq: 'daily' },
    { loc: `${origin}/faq`, lastmod: latestAreaUpdate, priority: '0.50', changefreq: 'monthly' },
    { loc: `${origin}/privacy`, lastmod: latestAreaUpdate, priority: '0.30', changefreq: 'yearly' },
    { loc: `${origin}/terms`, lastmod: latestAreaUpdate, priority: '0.30', changefreq: 'yearly' },
  ]

  const xmlStaticPages = staticPages.map(({ loc, lastmod, priority, changefreq }) =>
    `<url>
    <loc>${escapeXml(loc)}</loc>
    <lastmod>${lastmod}</lastmod>
    <changefreq>${changefreq}</changefreq>
    <priority>${priority}</priority>
  </url>`
  ).join('\n  ')

  const xmlAreas = (areas || [])
    .map(
      (area) => {
        const lastmod = area?.getString('updated')
          ? (new Date(area.getString('updated')).toISOString().split('.')[0] + 'Z')
          : latestAreaUpdate
        const path = buildAreaUrl(area?.id, area?.getString('name'))
        return `<url>
    <loc>${escapeXml(`${origin}${path}`)}</loc>
    <lastmod>${lastmod}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.80</priority>
  </url>`
      }
    )
    .join('\n  ')

  const xmlSnippet = `<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  ${xmlStaticPages}
  ${xmlAreas}
</urlset>`

  response.write(xmlSnippet)
</script>
