<div class="drawer-side z-50">
    <label for="my-drawer-3" aria-label="Close sidebar navigation" class="drawer-overlay"></label>
    <nav aria-label="Mobile Navigation" class="min-h-full w-80 bg-base-200/80 backdrop-blur-md p-4">
        <ul class="menu">
            <!-- Sidebar content here -->
            <% data.navigation.forEach(function(item) { %>
                <li>
                    <a href="<%= item.url %>" onclick="const d = document.getElementById('my-drawer-3'); if (d) d.checked = false;">
                        <%= item.title %>
                    </a>
                </li>
                <% }); %>
            <li class="mt-2 pt-2 border-t border-base-content/10">
                <% if (data.user) { %>
                    <a href="/logout" onclick="const d = document.getElementById('my-drawer-3'); if (d) d.checked = false;">
                        Logout (<%= data.user.displayName %>)
                    </a>
                <% } else { %>
                    <% const loginUrl = (data.currentPath && data.currentPath !== '/' && !data.currentPath.startsWith('/login')) ? `/login?redirect=${encodeURIComponent(data.currentPath)}` : '/login'; %>
                    <a href="<%= loginUrl %>" onclick="const d = document.getElementById('my-drawer-3'); if (d) d.checked = false;">
                        Login
                    </a>
                <% } %>
            </li>
        </ul>
    </nav>
</div>