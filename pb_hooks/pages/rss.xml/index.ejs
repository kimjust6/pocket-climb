<script server>
  const { buildAreaUrl } = require(`${__hooks}/pages/utils/common.js`)
  const { getAreas } = require(`${__hooks}/pages/utils/pocket.js`)
  const areasPage = getAreas(1, 50, "")
  const areas = areasPage.items || []

  const buildDate = new Date().toUTCString()
  const description = "An open source community drive wiki that provides information on climbs"

  const items = areas.map(area => {
    const pubDate = new Date(area.getString('updated') || area.getString('created') || Date.now()).toUTCString()
    const areaLink = `https://wiki-bloc.jkim.win${buildAreaUrl(area.id, area.getString('name'))}`
    const rawDesc = area.getString('description') || `Explore ${area.getInt('totalClimbs') || 0} climbs in ${area.getString('name')}.`
    const areaDesc = rawDesc
      .replace(/<[^>]*>/g, '')
      .substring(0, 300)
      + (rawDesc.length > 300 ? '...' : '')

    return `
    <item>
      <title><![CDATA[${area.getString('name')}]]></title>
      <link>${areaLink}</link>
      <guid>${areaLink}</guid>
      <pubDate>${pubDate}</pubDate>
      <description><![CDATA[${areaDesc}]]></description>
    </item>`
  }).join('')

  const rss = `<?xml version="1.0" encoding="UTF-8" ?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>Wiki Bloc</title>
    <link>https://wiki-bloc.jkim.win</link>
    <description>${description}</description>
    <language>en-us</language>
    <lastBuildDate>${buildDate}</lastBuildDate>
    <atom:link href="https://wiki-bloc.jkim.win/rss.xml" rel="self" type="application/rss+xml" />
    ${items}
  </channel>
</rss>`

  response.header('Content-Type', 'application/xml')
  response.write(rss)
</script>