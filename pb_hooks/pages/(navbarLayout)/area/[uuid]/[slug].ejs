<script server>
    const { prepareAreaDetailViewData } = require(`${__hooks}/pages/utils/common.js`)
    const reqObj = typeof request !== 'undefined' ? request : null
    const areaView = prepareAreaDetailViewData(params, reqObj, data)

    if (!areaView) {
        api.status = 404
    } else if (areaView.shouldRedirect && areaView.canonicalPath) {
        if (typeof response !== 'undefined' && typeof response.redirect === 'function') {
            response.redirect(areaView.canonicalPath, 301)
        } else {
            redirect(areaView.canonicalPath)
        }
    }
</script>

<% if (!areaView) { %>
    <%- include('pagenotfound.ejs') %>
<% } else { %>
    <div class="bg-base-100 pt-24 pb-20 min-h-[calc(100vh-12.54rem)] not-prose">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">

            <!-- Top Navigation & Breadcrumbs -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                <nav aria-label="Area Breadcrumbs" class="text-sm breadcrumbs py-0 overflow-x-auto">
                    <ul>
                        <li>
                            <a href="/" class="text-base-content/70 hover:text-accent no-underline font-medium">
                                All Locations
                            </a>
                        </li>
                        <% (areaView.breadcrumbs || []).forEach(crumb => { %>
                            <li>
                                <% if (crumb.isCurrent) { %>
                                    <span class="font-semibold text-secondary"><%= crumb.name %></span>
                                <% } else { %>
                                    <a href="<%= crumb.url %>" class="text-base-content/70 hover:text-accent no-underline">
                                        <%= crumb.name %>
                                    </a>
                                <% } %>
                            </li>
                        <% }); %>
                    </ul>
                </nav>

                <a href="/" class="btn btn-accent btn-sm gap-2 rounded-xl shrink-0 self-start sm:self-auto">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round" aria-hidden="true">
                        <path d="m12 19-7-7 7-7" />
                        <path d="M19 12H5" />
                    </svg>
                    All Locations
                </a>
            </div>

            <!-- Area Header Card -->
            <div class="card dark:bg-base-300/70 bg-base-300/60 backdrop-blur-xl border border-secondary/20 rounded-2xl p-6 sm:p-8 mb-10 shadow-xl">
                <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
                    <div>
                        <div class="flex flex-wrap items-center gap-3 mb-2">
                            <h1 class="text-3xl sm:text-5xl font-bold text-accent tracking-tight">
                                <%= areaView.name %>
                            </h1>
                            <% if (areaView.shortCode) { %>
                                <span class="badge badge-outline border-accent/40 text-accent font-mono">
                                    <%= areaView.shortCode %>
                                </span>
                            <% } %>
                        </div>

                        <% if (areaView.hasCoords) { %>
                            <div class="flex flex-wrap items-center gap-4 text-xs text-base-content/70 font-mono mt-2">
                                <span class="inline-flex items-center gap-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-secondary" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                                    </svg>
                                    <%= areaView.lat.toFixed(4) %>, <%= areaView.lng.toFixed(4) %>
                                </span>
                                <a href="https://www.google.com/maps/search/?api=1&query=<%= areaView.lat %>,<%= areaView.lng %>"
                                    target="_blank" rel="noopener noreferrer"
                                    class="text-accent hover:underline inline-flex items-center gap-1">
                                    Google Maps ↗
                                </a>
                            </div>
                        <% } %>
                    </div>

                    <div class="flex flex-wrap items-center gap-2 shrink-0">
                        <div class="stats bg-base-100/80 border border-base-content/10 shadow-sm rounded-xl">
                            <div class="stat py-2 px-4">
                                <div class="stat-title text-xs">Total Climbs</div>
                                <div class="stat-value text-xl sm:text-2xl text-secondary font-mono">
                                    <%= areaView.formattedClimbs %>
                                </div>
                            </div>
                            <% if (areaView.children && areaView.children.length > 0) { %>
                                <div class="stat py-2 px-4">
                                    <div class="stat-title text-xs">Sub-Areas</div>
                                    <div class="stat-value text-xl sm:text-2xl text-accent font-mono">
                                        <%= areaView.children.length %>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <% if (areaView.descriptionHtml || areaView.areaLocationHtml) { %>
                    <div class="grid gap-6 <%= (areaView.descriptionHtml && areaView.areaLocationHtml) ? 'md:grid-cols-2' : 'grid-cols-1' %> mt-6 pt-6 border-t border-base-content/10 text-sm text-base-content/90 leading-relaxed">
                        <% if (areaView.descriptionHtml) { %>
                            <div>
                                <h2 class="text-xs font-bold uppercase tracking-wider text-secondary mb-2.5">Description</h2>
                                <div class="markdown-content space-y-2.5"><%- areaView.descriptionHtml %></div>
                            </div>
                        <% } %>
                        <% if (areaView.areaLocationHtml) { %>
                            <div>
                                <h2 class="text-xs font-bold uppercase tracking-wider text-secondary mb-2.5">Approach & Location</h2>
                                <div class="markdown-content space-y-2.5"><%- areaView.areaLocationHtml %></div>
                            </div>
                        <% } %>
                    </div>
                <% } %>
            </div>

            <!-- Sub-Areas / Regions / Crags Directory (Vue Islands Architecture) -->
            <% if (areaView.children && areaView.children.length > 0) { %>
                <%- include('area-subareas-island.ejs', { areaView }) %>
            <% } %>

            <!-- Climbs / Routes List & Explorer (Vue Islands Architecture) -->
            <% if (areaView.climbs && areaView.climbs.length > 0) { %>
                <%- include('area-climbs-island.ejs', { areaView }) %>

                <%- include('climb-media-modals.ejs', {
                    climbs: areaView.climbs || [],
                    canonicalPath: areaView.canonicalPath,
                    isAuthenticated: areaView.isAuthenticated,
                    isImgurConfigured: areaView.isImgurConfigured,
                    imgurClientId: areaView.imgurClientId
                }) %>
            <% } %>

            <% if ((!areaView.children || areaView.children.length === 0) && (!areaView.climbs || areaView.climbs.length === 0)) { %>
                <div class="card dark:bg-base-300/70 bg-base-300/60 border border-secondary/20 rounded-xl p-8 text-center">
                    <p class="text-base text-base-content/80">
                        No sub-areas or climbs are currently listed under <strong><%= areaView.name %></strong>.
                    </p>
                </div>
            <% } %>

        </div>
    </div>
<% } %>

