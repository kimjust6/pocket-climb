<!doctype html>
<html
    lang="en"
    data-theme="<%= data.theme %>"
    class="<%= data.theme === 'dark' ? 'dark' : '' %>"
>
    <head>
        <script src="/js/site-init.js"></script>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta
            http-equiv="Content-Security-Policy"
            content="
                default-src 'self';
                script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.youtube.com https://youtube.com https://*.ytimg.com https://www.googletagmanager.com https://www.google.com https://cdnjs.cloudflare.com;
                frame-src 'self' https://*.youtube.com https://youtube.com https://*.youtube-nocookie.com;
                img-src 'self' data: blob: https://i.imgur.com https://*.imgur.com https://media.openbeta.io https://*.ytimg.com https://*.youtube.com https://*.ggpht.com https://www.google.com https://www.googletagmanager.com;
                connect-src 'self' https://api.imgur.com https://*.youtube.com https://youtubei.googleapis.com https://yt3.ggpht.com https://www.google-analytics.com https://www.googletagmanager.com;
                media-src 'self' blob: https://*.youtube.com https://*.googlevideo.com;
                style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com;
                font-src 'self' data: https://cdnjs.cloudflare.com;
                worker-src 'self' blob:;
            "
        />

        <% data.metadata.forEach(function(ogTag) { %>
            <% if (ogTag && ogTag.content) { %>
                <% if (ogTag.name.startsWith('og:') || ogTag.name.startsWith('article:')) { %>
        <meta property="<%= ogTag.name %>" content="<%= ogTag.content %>" />
                <% } else { %>
        <meta name="<%= ogTag.name %>" content="<%= ogTag.content %>" />
                <% } %>
            <% } %>
        <% }); %>

        <title><%= data.metadata.find(x => x.name === 'title')?.content || 'Wiki Bloc' %></title>
        <% const canonicalUrl = data.metadata.find(x => x.name === 'og:url' || x.name === 'url')?.content; %>
        <% if (canonicalUrl) { %>
        <link rel="canonical" href="<%= canonicalUrl %>" />
        <% } %>

        <!-- Mobile & Browser Theme Color -->
        <meta name="theme-color" content="#2D6392" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#0f141c" media="(prefers-color-scheme: dark)" />
        <meta name="theme-color" content="#0f141c" />

        <!-- Favicons & App Icons -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
        <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="manifest" href="/site.webmanifest" />

        <!-- Styles & Preconnects -->
        <link href="<%=asset('/app.css')%>" rel="stylesheet" />
        <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />

        <!-- Structured Data (JSON-LD) -->
        <%
            const metaGet = (key) => (data.metadata || []).find(m => m.name === key)?.content;
            const isArticle = metaGet('og:type') === 'article';
            const pageCanonical = metaGet('og:url') || metaGet('url') || 'https://wiki-bloc.jkim.win/';
            const pageTitle = metaGet('og:title') || metaGet('title') || 'Wiki Bloc';
            const pageDesc = metaGet('og:description') || metaGet('description') || 'An open source community drive wiki that provides information on climbs';
            const pageImg = metaGet('og:image') || 'https://wiki-bloc.jkim.win/og-image.png';

            let jsonLd;
            if (isArticle) {
                jsonLd = {
                    "@context": "https://schema.org",
                    "@type": "WebPage",
                    "mainEntityOfPage": {
                        "@type": "WebPage",
                        "@id": pageCanonical
                    },
                    "name": pageTitle,
                    "description": pageDesc,
                    "image": [pageImg],
                    "publisher": {
                        "@type": "Organization",
                        "name": "Wiki Bloc",
                        "url": "https://wiki-bloc.jkim.win/"
                    }
                };
                const keywords = metaGet('keywords');
                if (keywords) jsonLd.keywords = keywords;
            } else {
                jsonLd = {
                    "@context": "https://schema.org",
                    "@type": "WebSite",
                    "name": "Wiki Bloc",
                    "url": pageCanonical,
                    "description": pageDesc,
                    "potentialAction": {
                        "@type": "SearchAction",
                        "target": `${pageCanonical.replace(/\/+$/, '')}/?query={search_term_string}`,
                        "query-input": "required name=search_term_string"
                    },
                    "publisher": {
                        "@type": "Organization",
                        "name": "Wiki Bloc",
                        "url": "https://wiki-bloc.jkim.win/"
                    }
                };
            }
        %>
        <script type="application/ld+json">
<%- JSON.stringify(jsonLd, null, 2) %>
        </script>
        <!-- Speculation Rules API for instant navigation prerendering & prefetching -->
        <script type="speculationrules">
        {
            "prerender": [
                {
                    "where": {
                        "and": [
                            { "href_matches": "/*" },
                            { "not": { "href_matches": "/api/*" } },
                            { "not": { "href_matches": "/login*" } },
                            { "not": { "href_matches": "/logout*" } },
                            { "not": { "href_matches": "/signup*" } },
                            { "not": { "selector_matches": "[rel~=nofollow]" } }
                        ]
                    },
                    "eagerness": "moderate"
                }
            ],
            "prefetch": [
                {
                    "where": {
                        "and": [
                            { "href_matches": "/*" },
                            { "not": { "href_matches": "/api/*" } },
                            { "not": { "href_matches": "/logout*" } }
                        ]
                    },
                    "eagerness": "conservative"
                }
            ]
        }
        </script>
        <!-- Vue 3 & Vue Router (No-Build Mode - Local) -->
        <script src="/js/vue.global.prod.js"></script>
        <script src="/js/vue-router.global.prod.js"></script>
        <script src="/js/app-router.js?v=2"></script>
        <!-- Google tag (gtag.js) -->
        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-6P8M4DJNQL"
        ></script>
    </head>

    <body class="flex min-h-screen flex-col">
        <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-4 focus:left-4 focus:p-4 focus:bg-primary focus:text-primary-content focus:rounded-md focus:shadow-lg">Skip to main content</a>
        <div class="drawer flex-1">
            <input id="my-drawer-3" type="checkbox" class="drawer-toggle" aria-label="Toggle navigation drawer" />
            <div class="drawer-content flex min-h-full flex-col">
                <!-- Navbar -->
                <%- include('navbar.ejs') %>
                <main id="main-content" tabindex="-1" class="prose max-w-none flex-1 pt-16">
                    <%- slot %>
                </main>
            </div>
            <%- include('sidebar.ejs') %>
        </div>

        <%- include('footer.ejs') %>
    </body>
</html>
