{
  "name": "pocket-climb",
  "private": true,
  "version": "0.0.2",
  "scripts": {
    "dev": "concurrently \"tailwindcss -i ./pb_hooks/pages/app.tailwind.css -o ./pb_hooks/pages/app.css --minify --watch\" \"pocketbase serve --dir=pb_data --dev\"",
    "start": "pocketbase serve --dir=pb_data --dev",
    "wsl": "wsl bash -c \"set -a && source .env && set +a && npm run dev\"",
    "css": "tailwindcss -i ./pb_hooks/pages/app.tailwind.css -o ./pb_hooks/pages/app.css --minify --watch",
    "build:css": "tailwindcss -i ./pb_hooks/pages/app.tailwind.css -o ./pb_hooks/pages/app.css --minify",
    "build": "npm run build:css",
    "check": "node -c pb_hooks/main.pb.js && node -c pb_hooks/mcp.pb.js && node -c pb_hooks/pocketpages.pb.js && node -c pb_hooks/pages/utils/common.js && node -c pb_hooks/pages/utils/analytics.js && node -c pb_hooks/pages/utils/media.js && node -c pb_hooks/pages/utils/markdown.js && node -c pb_hooks/pages/utils/pocket.js && node -c pb_hooks/pages/utils/auth-queries.js && node -c pb_hooks/pages/utils/sync-logs.js && node -c pb_hooks/pages/utils/constants.js && node -c pb_public/js/site-init.js",
    "test": "node --test tests/*.test.js",
    "push2": "node scripts/push.mjs mlt-blog",
    "push": "node scripts/push.mjs my-blog",
    "push:code": "npx phio deploy my-blog -e pb_data \"pb_data/**/*\" \"*.db*\"",
    "migrate:prod": "PB_TARGET_URL=https://wiki-bloc.jkim.win node -e \"import('./scripts/setup-openbeta-collections.mjs').then(m=>m.setupCollections({url:'https://wiki-bloc.jkim.win'}))\"",
    "migrate:up": "pocketbase migrate up --dir=pb_data",
    "login": "npx phio login",
    "postinstall": "patch-package",
    "update": "pocketbase update",
    "typegen": "node scripts/typegen.mjs",
    "setup:openbeta": "node scripts/setup-openbeta-collections.mjs",
    "seed:openbeta": "node scripts/seed-openbeta-locations.mjs",
    "sync:imgur": "python3 scripts/sync-media-to-imgur.py",
    "sync:data": "node -e 'fetch(\"http://127.0.0.1:8090/api/sync\").then(r=>r.json()).then(console.log)'"
  },
  "description": "Wiki Bloc — an open-source community climbing wiki built with PocketPages, PocketBase, and DaisyUI.",
  "author": {
    "name": "Justin Kim",
    "github": "kimjust6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kimjust6/pocket-climb/"
  },
  "keywords": [
    "pocketpages",
    "pocketbase",
    "climbing",
    "openbeta",
    "daisyui"
  ],
  "devDependencies": {
    "@esbuild/linux-x64": "^0.28.1",
    "@tailwindcss/typography": "^0.5.16",
    "concurrently": "^9.2.1",
    "daisyui": "^4.12.23",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "patch-package": "^8.0.1",
    "phio": "^0.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-ejs": "^1.0.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "basic-ftp": "^6.2.1",
    "chokidar": "^4.0.3"
  },
  "dependencies": {
    "pbjsmcp": "github:benallfree/pbjsmcp",
    "pocketbase": "^0.26.6",
    "pocketpages": ">=0.22.3",
    "pocketpages-plugin-js-sdk": "^0.2.0"
  },
  "files": [
    "pb_hooks",
    "*.md"
  ]
}
